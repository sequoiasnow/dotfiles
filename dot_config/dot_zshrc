# Save install cmd
function is_installed() {
  if command -v $1 &>/dev/null; then
    true
  else
    echo "$1 not installed! Truly, a tradgedy"
    echo
    echo "  Try running:"
    echo "  >" ${2:-"brew install $1"}
    echo 
    echo " -- Sincerely, your past self (that bitch!)"
    echo
    false
  fi 
}

# Add xcode deps (things like lldb-dap, and other conveniances)
export PATH="/Library/Developer/CommandLineTools/usr/bin/:$PATH"

# Add brew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Add docker
export PATH="$HOME/.docker/bin:$PATH"

# Add gcloud CLI to path
if [ -f /opt/homebrew/share/zsh/site-functions/_google_cloud_sdk ]; then
  source /opt/homebrew/share/zsh/site-functions/_google_cloud_sdk
fi

# Optionally, add gcloud binaries to path
if [ -f /opt/homebrew/share/google-cloud-sdk/path.zsh.inc ]; then
  source /opt/homebrew/share/google-cloud-sdk/path.zsh.inc
fi 

# Add ghcup to path
export PATH="$HOME/.ghcup/bin:$PATH"

# Ensure custom scripts are present
export PATH="$HOME/.config/scripts:$PATH"

# Add any locally installed binaries
export PATH="$HOME/.local/bin:$PATH"

# Let's do some magic with gcc
# if command -v gcc-13; then
#     ln -sf $(readlink -f $(which gcc-13)) $(which gcc-13 | cut -d - -f 1)
# fi

export DRADIS_SCRIPTS_DIR="$HOME/dev/dradis-infra"
if [ -d $DRADIS_SCRIPTS_DIR ]; then
  export PATH="$PATH:$DRADIS_SCRIPTS_DIR"
fi

export ULTRA_IMAGES="us-central1-docker.pkg.dev/dradis-75/dradis-images"


# Print a fortune
if is_installed fortune; then
  fortune
fi

# Setup thefuck
if is_installed thefuck; then
  eval $(thefuck --alias)
fi

# Set the editor to helix (vim can bite me)
if is_installed hx 'brew install helix'; then
  export EDITOR=hx
elif is_installed emacs; then
  export EDITOR=emacs
elif is_installed vim; then
  export EDITOR=vim
fi

# Some common emacs aliases
alias ec="emacsclient"
alias e="emacs"

# Use the starship prompt
eval "$(starship init zsh)"

